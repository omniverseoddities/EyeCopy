{
  "name": "eyecopy",
  "version": "1.0.0",
  "description": "EyeCopy Windows desktop interface for iPhone media and shared files",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "desktop/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": ".venv\\Scripts\\python.exe -m unittest discover -s backend -p test_*.py -v",
    "check": "node --check desktop/main.js && node --check desktop/preload.js && node --check ui/app.js",
    "test:desktop": "node --test tests/*.test.js",
    "setup:media": ".venv\\Scripts\\python.exe build-support\\media\\BuildMedia.py",
    "build": ".venv\\Scripts\\python.exe scripts\\BuildPortable.py",
    "release": ".venv\\Scripts\\python.exe scripts\\PrepareRelease.py"
  },
  "devDependencies": {
    "electron": "44.7.0"
  },
  "dependencies": {
    "koffi": "3.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omniverseoddities/EyeCopy"
  }
}
